{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "Astro docs": {
            "type": "remote",
            "url": "https://mcp.docs.astro.build/mcp",
            "enabled": true
        }
    }
}
