---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = 'Galería de imágenes' } = Astro.props;
---

{images.length > 0 && (
  <div class="carousel" role="region" aria-label={label} data-carousel>
    <div class="carousel__viewport" data-embla>
      <div class="carousel__container">
        {images.map((img, i) => (
          <div class="carousel__slide">
            <figure class="carousel__figure">
              <Image
                class="carousel__image"
                src={img.src}
                alt={img.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          </div>
        ))}
      </div>
    </div>

    <button class="carousel__btn carousel__btn--prev" type="button"
      aria-label="Imagen anterior" data-carousel-prev disabled>
      <Icon name="mdi:chevron-left" aria-hidden="true" />
    </button>
    <button class="carousel__btn carousel__btn--next" type="button"
      aria-label="Imagen siguiente" data-carousel-next>
      <Icon name="mdi:chevron-right" aria-hidden="true" />
    </button>

    <div class="carousel__dots" role="tablist" aria-label="Slides del carrusel" data-carousel-dots>
    </div>

    <button class="carousel__btn carousel__btn--expand" type="button"
      aria-label="Ver imagen en grande" data-carousel-expand>
      <Icon name="mdi:magnify" aria-hidden="true" />
    </button>

    <dialog class="carousel__dialog" aria-label="Imagen ampliada" data-carousel-dialog>
      <img class="carousel__dialog-img" alt="" data-carousel-dialog-image />
      <button class="carousel__dialog-close" type="button"
        aria-label="Cerrar imagen" data-carousel-dialog-close>
        <Icon name="mdi:close" aria-hidden="true" />
      </button>
    </dialog>
  </div>
)}

<style>
  .carousel {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .carousel__viewport {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .carousel__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  .carousel__slide {
    flex: 0 0 100%;
    min-width: 0;
    padding: 0 var(--spacing-xs);
  }

  .carousel__figure {
    margin: 0;
  }

  .carousel__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    user-select: none;
    -webkit-user-drag: none;
  }

  .carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;

    &:hover:not(:disabled) {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: 0.3;
      cursor: default;
    }
  }

  .carousel__btn--prev {
    left: var(--spacing-sm);
  }

  .carousel__btn--next {
    right: var(--spacing-sm);
  }

  .carousel__btn--expand {
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    transform: none;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) 0 0;
  }

  .carousel__dot {
    width: 8px;
    height: 8px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-border);
    padding: 0;
    cursor: pointer;
    transition: background 0.15s;

    &--active {
      background: var(--color-primary);
    }

    &:hover {
      background: var(--color-muted);
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
  }

  .carousel__dialog {
    border: none;
    margin: auto;
    overscroll-behavior: contain;
    padding: 0;
    max-width: min(90vw, 1000px);
    width: 100%;

    &::backdrop {
      background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    }
  }

  .carousel__dialog-img {
    display: block;
    width: 100%;
    border-radius: var(--radius-md);
  }

  .carousel__dialog-close {
    position: absolute;
    top: calc(-1 * var(--spacing-lg));
    right: 0;
    width: 40px;
    height: 40px;
    border: none;
    cursor: pointer;
    touch-action: manipulation;

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';
  import type { EmblaCarouselType } from 'embla-carousel';

  const instances = new WeakMap<HTMLElement, EmblaCarouselType>();

  function initCarousel(root: HTMLElement) {
    const existing = instances.get(root);
    if (existing) {
      existing.destroy();
      instances.delete(root);
    }

    const viewportNode = root.querySelector<HTMLElement>('[data-embla]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dotsContainer = root.querySelector<HTMLElement>('[data-carousel-dots]');
    const expandBtn = root.querySelector<HTMLButtonElement>('[data-carousel-expand]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-carousel-dialog]');
    const dialogImage = root.querySelector<HTMLImageElement>('[data-carousel-dialog-image]');

    if (!viewportNode) return;

    const embla = EmblaCarousel(viewportNode, {
      loop: false,
      align: 'center',
      containScroll: 'trimSnaps',
      slidesToScroll: 1,
    });

    instances.set(root, embla);

    const toggleButtons = () => {
      prevBtn?.toggleAttribute('disabled', !embla.canScrollPrev());
      nextBtn?.toggleAttribute('disabled', !embla.canScrollNext());
    };

    const scrollPrev = () => embla.scrollPrev();
    const scrollNext = () => embla.scrollNext();

    prevBtn?.addEventListener('click', scrollPrev);
    nextBtn?.addEventListener('click', scrollNext);

    const buildDots = () => {
      if (!dotsContainer) return;
      const count = embla.scrollSnapList().length;
      dotsContainer.innerHTML = '';
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'carousel__dot';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Slide ${i + 1}`);
        dot.setAttribute('aria-selected', 'false');
        dot.dataset.index = String(i);
        dot.addEventListener('click', () => embla.scrollTo(i));
        dotsContainer.appendChild(dot);
      }
    };

    const setActiveDot = () => {
      if (!dotsContainer) return;
      const selected = embla.selectedScrollSnap();
      dotsContainer.querySelectorAll<HTMLElement>('.carousel__dot').forEach((dot, i) => {
        const isActive = i === selected;
        dot.classList.toggle('carousel__dot--active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });
    };

    const openLightbox = () => {
      const slides = embla.slideNodes();
      const activeSlide = slides[embla.selectedScrollSnap()];
      const img = activeSlide?.querySelector('img');
      if (!dialog || !dialogImage || !img) return;
      dialogImage.src = img.src;
      dialogImage.alt = img.alt;
      dialog.showModal();
    };

    const closeLightbox = () => dialog?.close();

    expandBtn?.addEventListener('click', openLightbox);
    dialog?.querySelector('[data-carousel-dialog-close]')
      ?.addEventListener('click', closeLightbox);
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) closeLightbox();
    });

    const onSelect = () => {
      toggleButtons();
      setActiveDot();
    };

    embla.on('select', onSelect);

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); embla.scrollPrev(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); embla.scrollNext(); }
    };

    root.addEventListener('keydown', onKeyDown);

    buildDots();
    toggleButtons();
    setActiveDot();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
  }

  initAll();
</script>
