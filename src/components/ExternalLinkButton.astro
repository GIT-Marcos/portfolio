---
import { externalLinkCategories } from '@data/externalLinks';
import type { ExternalLinkCategory } from '@data/externalLinks';
import { Icon } from 'astro-icon/components';

export interface Props {
  label?: string;
  url: string;
  category: ExternalLinkCategory;
  icon?: string;
}

const { url, category, icon } = Astro.props;
const config = externalLinkCategories[category];
const label = Astro.props.label ?? config.defaultLabel;
const iconSrc = icon ?? config.defaultIcon;
// mailto:/tel: no deben abrir en pestaña nueva; solo URLs http(s)
const isExternal = /^https?:\/\//i.test(url);
---

<a
  class:list={['link-button', `link-button--${category}`]}
  href={url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <Icon name={iconSrc} class="link-button__icon" aria-hidden="true" width={20} height={20} />
  <span class="link-button__label">{label}</span>
</a>

<style>
  .link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-sm);
    font-size: var(--font-size-sm);
    border: 1px solid var(--btn-accent);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;

    &:hover {
      border-color: var(--btn-accent);
      box-shadow: 0 0 12px color-mix(in srgb, var(--btn-accent) 100%, transparent);
      color: var(--btn-accent);
    }

    &:focus-visible {
      outline: 2px solid var(--btn-accent);
      outline-offset: 2px;
    }
  }

  .link-button--github   { --btn-accent: var(--color-github); }
  .link-button--linkedin { --btn-accent: var(--color-linkedin); }
  .link-button--whatsapp { --btn-accent: var(--color-whatsapp); }
  .link-button--website  { --btn-accent: var(--color-website); }
  .link-button--email    { --btn-accent: var(--color-email); }
  .link-button--generic  { --btn-accent: var(--color-generic); }

  .link-button__icon {
    flex-shrink: 0;
  }
</style>
