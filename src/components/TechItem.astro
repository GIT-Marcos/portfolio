---
import { Icon } from 'astro-icon/components';

export interface Props {
  name: string;
  icon: string;
  iconSize?: number;
}

const { name, icon, iconSize = 32 } = Astro.props;
---

<div class="tech-item" style={`--icon-size: ${iconSize}px`}>
    <Icon name={icon} class="tech-item__icon" aria-hidden="true" width={iconSize} height={iconSize} />
  <span class="tech-item__name">{name}</span>
</div>

<style>
  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .tech-item__icon {
    width: var(--icon-size, 32px);
    height: var(--icon-size, 32px);
    flex-shrink: 0;
  }

  .tech-item__name {
    font-size: var(--font-size-sm);
  }
</style>
