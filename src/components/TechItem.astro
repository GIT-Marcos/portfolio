---
import { Icon } from 'astro-icon/components';

export interface Props {
  name: string;
  icon: string;
  alt: string;
}

const { name, icon, alt } = Astro.props;
---

<div class="tech-item">
    <Icon name={icon} class="tech-item__icon" aria-hidden="true" width={24} height={24} />
  <span class="tech-item__name">{name}</span>
</div>

<style>
  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface);
    border-radius: 8px;
  }

  .tech-item__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .tech-item__name {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
  }
</style>
