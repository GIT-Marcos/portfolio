---
import { Icon } from 'astro-icon/components';

export interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div class="tech-item">
    <Icon name={icon} class="tech-item__icon" aria-hidden="true" />
  <span class="tech-item__name">{name}</span>
</div>

<style>
  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-sm);
    background-color: transparent;
    border-radius: var(--radius-sm);
  }

  .tech-item__icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }

  .tech-item__name {
    font-size: var(--font-size-sm);
  }
</style>
