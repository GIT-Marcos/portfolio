---
import { navItems } from '@data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__container">
    <a class="header__logo" href="/">Portfolio</a>
    <nav class="header__nav">
      <ul class="header__nav-list">
        {navItems.map((item) => (
          <li class="header__nav-item">
            <a
              class:list={[
                'header__nav-link',
                { 'header__nav-link--active': currentPath === item.href },
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-md) var(--spacing-lg);

    @media (max-width: 640px) {
      flex-direction: column;
      gap: var(--spacing-md);
    }
  }

  .header__logo {
    font-size: var(--font-size-xl);
  }

  .header__nav-list {
    display: flex;
    list-style: none;
    gap: var(--spacing-lg);

    @media (max-width: 640px) {
      gap: var(--spacing-md);
    }
  }

  .header__nav-link {
    padding: var(--spacing-xs) var(--spacing-sm);
  }
</style>
