---
import { Icon } from 'astro-icon/components';

export interface Props {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

const { label, href, variant = 'primary' } = Astro.props;
---

<a
  class:list={['internal-link-button', `internal-link-button--${variant}`]}
  href={href}
>
  <span class="internal-link-button__label">{label}</span>
  <Icon class="internal-link-button__arrow" name="mdi:arrow-right" aria-hidden="true" />
</a>

<style>
  .internal-link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-xl);
  }

  .internal-link-button__arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
</style>
