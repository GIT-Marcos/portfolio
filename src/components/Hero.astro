---
import InternalLinkButton from './InternalLinkButton.astro';
import { Icon } from 'astro-icon/components';
import { profile } from '@data/profile';
import { heroAsciiArt } from '@data/ascii-art';
import { heroAsciiArtMobile } from '@data/ascii-artMobile';
---
<section class="hero">
  <div class="hero__container">
    <div class="hero__ascii-wrapper">
      <pre class="hero__ascii hero__ascii--desktop" style={{ '--ascii-font-size': heroAsciiArt.fontSize }} role="img" aria-label={heroAsciiArt.alt}>{heroAsciiArt.art}</pre>
      {heroAsciiArtMobile.art.trim() && (
        <pre class="hero__ascii hero__ascii--mobile" style={{ '--ascii-font-size': heroAsciiArtMobile.fontSize }} role="img" aria-label={heroAsciiArtMobile.alt}>{heroAsciiArtMobile.art}</pre>
      )}
    </div>
    <div class="hero__content">
      <p class="hero__greeting">Hola, soy</p>
      <h1 class="hero__title">{profile.name}</h1>
      <p class="hero__role">Analista de Sistemas</p>
      <div class="hero__meta">
        <span class="hero__meta-item hero__location">
          <Icon name="mdi:map-marker-outline" class="hero__location-icon" aria-hidden="true" />
          {profile.location}
        </span>
        {profile.openToWork && (
          <span class="hero__meta-item hero__availability">
            <span class="hero__availability-dot" aria-hidden="true"></span>
            {profile.availabilityLabel}
          </span>
        )}
      </div>
      <p class="hero__description">
          Análisis de sistemas - Desarrollo y diseño web estático - Desarrollo back-end - Inteligencia artificial - Testing.
      </p>
      <div class="hero__cta">
        <InternalLinkButton label="Servicios" href="/services/" />
        <InternalLinkButton label="Ver proyectos" href="/projects/" variant="secondary" />
        <InternalLinkButton label="Sobre mí" href="/about/" variant="secondary" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-3xl) var(--spacing-lg);
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3xl);

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .hero__ascii-wrapper {
    flex: 0 0 40%;

    @media (max-width: 768px) {
      flex: none;
      width: 100%;
      max-width: 300px;
    }
  }

  .hero__ascii {
    font-family: var(--font-family-mono);
    font-size: var(--ascii-font-size, var(--font-size-sm));
    line-height: 1;
    white-space: pre;
    color: var(--color-secondary);
    overflow-x: auto;
    overflow-y: clip;
    font-variant-ligatures: none;
  }

  .hero__ascii--desktop {
    @media (max-width: 768px) {
      display: none;
    }
  }

  .hero__ascii--mobile {
    display: none;

    @media (max-width: 768px) {
      display: block;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  .hero__content {
    max-width: 640px;
    flex: 1;

    @media (max-width: 768px) {
      text-align: center;
    }
  }

  .hero__greeting {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-sm);
  }

  .hero__title {
    font-size: clamp(2.5rem, 5vw, var(--font-size-5xl));
    color: var(--color-phosphor);
    line-height: 1.1;
    margin-bottom: var(--spacing-md);
    text-shadow: 0 3px 60px color-mix(in srgb, var(--color-phosphor) 90%, transparent);
  }

  .hero__role {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-lg);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);

    @media (max-width: 768px) {
      justify-content: center;
    }
  }

  .hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
  }

  .hero__location-icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }

  .hero__availability {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: color-mix(in srgb, var(--color-available) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-available) 40%, transparent);
    border-radius: var(--radius-full);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__availability::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--color-available) 25%, transparent) 45%,
      color-mix(in srgb, var(--color-available) 40%, transparent) 50%,
      color-mix(in srgb, var(--color-available) 25%, transparent) 55%,
      transparent 100%
    );
    transform: translateX(-100%);
    animation: scanline 3s ease-in-out infinite;
    z-index: 1;
    pointer-events: none;
  }

  .hero__availability-dot {
    position: relative;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    background-color: var(--color-available);
    border-radius: var(--radius-full);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-available) 60%, transparent);
  }

  @keyframes scanline {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__availability::before {
      animation: none;
    }
  }

  .hero__description {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
    max-width: 520px;

    @media (max-width: 768px) {
      max-width: 100%;
    }
  }

  .hero__cta {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;

    @media (max-width: 768px) {
      justify-content: center;
    }
  }
</style>
