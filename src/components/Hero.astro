---
import InternalLinkButton from './InternalLinkButton.astro';
import { profile } from '@data/profile';
import { asciiArt } from '@data/ascii-art';
---
<section class="hero">
  <div class="hero__container">
    <div class="hero__ascii-wrapper">
      <pre class="hero__ascii" aria-label={asciiArt.alt}>{asciiArt.art}</pre>
    </div>
    <div class="hero__content">
      <p class="hero__greeting">Hola, soy</p>
      <h1 class="hero__title">{profile.name}</h1>
      <p class="hero__role">Analista de Sistemas · Desarrollador de Software</p>
      <div class="hero__meta">
        <span class="hero__meta-item hero__location">
          <svg
            class="hero__location-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          {profile.location}
        </span>
        {profile.openToWork && (
          <span class="hero__meta-item hero__availability">
            <span class="hero__availability-dot" aria-hidden="true"></span>
            {profile.availabilityLabel}
          </span>
        )}
      </div>
      <p class="hero__description">
        Construyo soluciones web limpias y funcionales. Me enfoco en código
        mantenible, arquitectura sólida y experiencias de usuario claras.
      </p>
      <div class="hero__cta">
        <InternalLinkButton label="Servicios" href="/services" />
        <InternalLinkButton label="Ver proyectos" href="/projects" variant="secondary" />
        <InternalLinkButton label="Sobre mí" href="/about" variant="secondary" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-3xl) var(--spacing-lg);
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3xl);

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .hero__ascii-wrapper {
    flex: 0 0 40%;

    @media (max-width: 768px) {
      flex: none;
      width: 100%;
      max-width: 300px;
    }
  }

  .hero__ascii {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    line-height: 1.4;
    white-space: pre;
    color: var(--color-text);
    overflow-x: auto;
  }

  .hero__content {
    max-width: 640px;
    flex: 1;

    @media (max-width: 768px) {
      text-align: center;
    }
  }

  .hero__greeting {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-sm);
  }

  .hero__title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: var(--spacing-md);
    color: var(--color-phosphor);
  }

  .hero__role {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-lg);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);

    @media (max-width: 768px) {
      justify-content: center;
    }
  }

  .hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
  }

  .hero__location-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .hero__availability {
    padding: var(--spacing-xs) var(--spacing-md);
  }

  .hero__availability-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  .hero__description {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
    max-width: 520px;

    @media (max-width: 768px) {
      max-width: 100%;
    }
  }

  .hero__cta {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;

    @media (max-width: 768px) {
      justify-content: center;
    }
  }
</style>
