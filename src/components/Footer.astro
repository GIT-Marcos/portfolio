---
import { socialItems } from '@data/social';
import { Icon } from 'astro-icon/components';
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__left">
      <span class="footer__name">Tu Nombre</span>
      <span class="footer__separator">|</span>
      <span class="footer__built">Build with <a class="footer__astro-link" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></span>
    </div>
    <div class="footer__social">
      {socialItems.map((item) => (
        <a
          class="footer__social-link"
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
        >
          <Icon name={item.icon} class="footer__social-icon" aria-hidden="true" />
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--spacing-lg) var(--spacing-lg);
    margin-top: auto;
  }

  .footer__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;

    @media (max-width: 640px) {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }

  .footer__left {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }

  .footer__social-icon {
    width: 24px;
    height: 24px;
  }
</style>
