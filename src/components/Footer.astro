---
import { profile } from '@data/profile';
import { getSocialItems } from '@data/social';
import ExternalLinkButton from './ExternalLinkButton.astro';

const socialButtons = getSocialItems('email', 'whatsapp', 'github');
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__left">
      <span>{profile.name}</span>
      <span>|</span>
      <span>Build with <a class="footer__link" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></span>
    </div>
    <div class="footer__social">
      {socialButtons.map((item) => (
        <ExternalLinkButton variant="icon" {...item} />
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--spacing-lg) var(--spacing-lg);
    margin-top: auto;
  }

  .footer__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;

    @media (max-width: 640px) {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }

  .footer__left {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    font-size: var(--font-size-sm);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);

    .link-button {
      background-color: transparent;
      border-color: transparent;

      &:hover {
        background-color: transparent;
        border-color: transparent;
      }
    }
  }

  .footer__link {
    color: var(--color-secondary);
  }
</style>
