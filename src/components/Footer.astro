---
import { socialItems } from '@data/social';
import { Icon } from 'astro-icon/components';
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__left">
      <span class="footer__name">Tu Nombre</span>
      <span class="footer__separator">|</span>
      <span class="footer__built">Build with <a class="footer__astro-link" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></span>
    </div>
    <div class="footer__social">
      {socialItems.map((item) => (
        <a
          class:list={['footer__social-link', `footer__social-link--${item.category}`]}
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
        >
          <Icon name={item.icon} class="footer__social-icon" aria-hidden="true" />
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--spacing-lg) var(--spacing-lg);
    margin-top: auto;
  }

  .footer__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;

    @media (max-width: 640px) {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }

  .footer__left {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    transition: color 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      color: var(--btn-accent);
      box-shadow: 0 0 12px color-mix(in srgb, var(--btn-accent) 100%, transparent);
    }

    &:focus-visible {
      outline: 2px solid var(--btn-accent);
      outline-offset: 2px;
    }
  }

  .footer__social-link--github   { --btn-accent: var(--color-github); }
  .footer__social-link--linkedin { --btn-accent: var(--color-linkedin); }
  .footer__social-link--email    { --btn-accent: var(--color-email); }

  .footer__social-icon {
    width: 24px;
    height: 24px;
  }
</style>
