---
import { Image } from 'astro:assets';
import type { Service } from '@data/services';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-section">
  <div class="service-section__media">
    <Image
      class="service-section__image"
      src={service.image}
      alt={service.imageAlt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="service-section__content">
    <h2 class="service-section__title text-gradient">{service.title}</h2>
    <p class="service-section__description">{service.description}</p>
  </div>
</article>

<style>
  .service-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg);

    @media (max-width: 768px) {
      flex-direction: column;
      text-align: center;
    }
  }

  .service-section__media {
    flex: 0 0 40%;

    @media (max-width: 768px) {
      flex: none;
      width: 100%;
      max-width: 320px;
    }
  }

  .service-section__image {
    width: 100%;
    height: auto;
  }

  .service-section__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .service-section__title {
    font-size: var(--font-size-xl);
  }

  .service-section__description {
    font-size: var(--font-size-base);
    line-height: 1.6;
  }
</style>
