---
import { Image } from 'astro:assets';
import type { Service } from '@data/services';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-section">
  <div class="service-section__media">
    <Image
      class="service-section__image"
      src={service.image}
      alt={service.imageAlt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="service-section__text">
    <h2 class="service-section__title text-gradient">{service.title}</h2>
    <p class="service-section__description">{service.description}</p>
  </div>
</article>

<style>
  .service-section {
    display: grid;
    grid-template-columns: 4fr 6fr;
    grid-template-areas: "media text";
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      grid-template-areas:
        "text"
        "media";
      text-align: center;
    }
  }

  .service-section__media {
    grid-area: media;
  }

  .service-section__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .service-section__title {
    font-size: var(--font-size-xl);
  }

  .service-section__image {
    width: 100%;
    height: auto;
  }

  .service-section__description {
    font-size: var(--font-size-base);
    line-height: 1.6;
  }
</style>
