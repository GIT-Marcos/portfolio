---
import type { Project } from '@data/projects';
import TechItem from './TechItem.astro';
import ExternalLinkButton from './ExternalLinkButton.astro';
import ImageCarousel from './ImageCarousel.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  title,
  description,
  technologies,
  links,
  isWIP = false,
  images,
} = project;
---

<article class="project-card">
  <div class="project-card__media">
    <ImageCarousel images={images} label={`Galería de capturas de ${title}`} />
    {isWIP && <span class="project-card__wip">Work in progress</span>}
  </div>

  <div class="project-card__content">
    <h3 class="project-card__title text-gradient">{title}</h3>
    <p class="project-card__description">{description}</p>

    <div class="project-card__tech" aria-label="Tecnologías utilizadas">
      {technologies.map((tech) => (
        <TechItem name={tech.name} icon={tech.icon} />
      ))}
    </div>

    <div class="project-card__actions">
      {links.map((link) => (
        <ExternalLinkButton {...link} />
      ))}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-xl);
    padding: var(--spacing-xl);

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .project-card__media {
    flex: 0 0 40%;
    min-width: 0;
    position: relative;

    @media (max-width: 768px) {
      flex: none;
    }
  }

  .project-card__wip {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-warning);
    background-color: var(--color-warning-bg);
    border: 1px solid color-mix(in srgb, var(--color-warning) 40%, transparent);
    border-radius: var(--radius-full);
    isolation: isolate;

    &::after {
      content: '█';
      animation: wip-blink 1s step-end infinite;
    }
  }

  @keyframes wip-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__wip::after {
      animation: none;
    }
  }

  .project-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .project-card__title {
    font-size: var(--font-size-xl);
  }

  .project-card__description {
    font-size: var(--font-size-base);
    line-height: 1.6;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: auto;
  }
</style>
