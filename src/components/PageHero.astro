---
import type { AsciiArt } from '@data/ascii-art';
import type { SocialItem } from '@data/social';
import ExternalLinkButton from './ExternalLinkButton.astro';

export interface Props {
  title: string;
  intro?: string;
  asciiArt?: AsciiArt;
  asciiArtMobile?: AsciiArt;
  socialItems?: SocialItem[];
  asciiPosition?: 'left' | 'right';
}

const {
  title,
  intro,
  asciiArt,
  asciiArtMobile,
  socialItems = [],
  asciiPosition = 'right',
} = Astro.props;
---

<section class:list={['page-hero', `page-hero--ascii-${asciiPosition}`]}>
  <div class="page-hero__content">
    <h1 class="page-hero__title">{title}</h1>
    {intro && <p class="page-hero__intro">{intro}</p>}
    {socialItems.length > 0 && (
      <div class="page-hero__social">
        {socialItems.map((item) => (
          <ExternalLinkButton {...item} />
        ))}
      </div>
    )}
    <slot />
  </div>
  {asciiArt && (
    <div class="page-hero__ascii-wrapper">
      <pre
        class:list={['page-hero__ascii', 'page-hero__ascii--desktop', { 'page-hero__ascii--flush-top': asciiArt.flushTop }]}
        style={{ '--ascii-font-size': asciiArt.fontSize }}
        role="img"
        aria-label={asciiArt.alt}
      >{asciiArt.art}</pre>
      {asciiArtMobile?.art.trim() && (
        <pre
          class:list={['page-hero__ascii', 'page-hero__ascii--mobile', { 'page-hero__ascii--flush-top': asciiArtMobile.flushTop }]}
          style={{ '--ascii-font-size': asciiArtMobile.fontSize }}
          role="img"
          aria-label={asciiArtMobile.alt}
        >{asciiArtMobile.art}</pre>
      )}
    </div>
  )}
</section>

<style>
  .page-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-3xl);

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: center;
    }
  }

  .page-hero--ascii-left {
    flex-direction: row-reverse;

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .page-hero__content {
    flex: 1;
    max-width: 60ch;
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
  }

  .page-hero__intro {
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .page-hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);

    @media (max-width: 768px) {
      justify-content: center;
    }
  }

  .page-hero__ascii-wrapper {
    flex: 0 0 35%;

    @media (max-width: 768px) {
      flex: none;
      width: 100%;
      max-width: 300px;
      order: -1;
    }
  }

  .page-hero__ascii {
    font-family: var(--font-family-mono);
    font-size: var(--ascii-font-size, var(--font-size-sm));
    line-height: 1;
    white-space: pre;
    color: var(--color-secondary);
    overflow-x: auto;
    overflow-y: clip;
    font-variant-ligatures: none;
  }

  .page-hero__ascii--flush-top {
    margin-top: calc(-1 * var(--spacing-3xl));
  }

  .page-hero__ascii--desktop {
    @media (max-width: 768px) {
      display: none;
    }
  }

  .page-hero__ascii--mobile {
    display: none;

    @media (max-width: 768px) {
      display: block;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }
  }
</style>
