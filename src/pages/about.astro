---
import Layout from '@layouts/layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ExternalLinkButton from '@components/ExternalLinkButton.astro';
import { aboutContent } from '@data/about';
import { getSocialItems } from '@data/social';

const socialButtons = getSocialItems('github', 'linkedin');
---

<Layout
  title="Portfolio | Sobre mí"
  description="Analista de sistemas con foco en backend Java y programación orientada a objetos"
>
  <Header />
  <main id="main" class="about-page">
    <div class="about-page__hero">
      <div class="about-page__hero-content">
        <h1 class="about-page__title">{aboutContent.heading}</h1>
        <p class="about-page__intro">{aboutContent.intro}</p>
        <div class="about-page__social">
          {socialButtons.map((item) => (
            <ExternalLinkButton {...item} />
          ))}
        </div>
      </div>
      <div class="about-page__ascii-wrapper">
        <pre
          class="about-page__ascii"
          aria-label={aboutContent.asciiArt.alt}
        >{aboutContent.asciiArt.art}</pre>
      </div>
    </div>

    {aboutContent.sections.map((section) => (
      <section class="about-section">
        <h2 class="about-section__title">{section.title}</h2>
        <p class="about-section__body">{section.body}</p>
      </section>
    ))}

    <p class="about-page__cta">{aboutContent.cta}</p>
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .about-page__hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-3xl);

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: center;
    }
  }

  .about-page__hero-content {
    flex: 1;
    max-width: 60ch;
  }

  .about-page__title {
    font-size: var(--font-size-3xl);
  }

  .about-page__intro {
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .about-page__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);

    @media (max-width: 768px) {
      justify-content: center;
    }
  }

  .about-page__ascii-wrapper {
    flex: 0 0 35%;

    @media (max-width: 768px) {
      flex: none;
      width: 100%;
      max-width: 300px;
    }
  }

  .about-page__ascii {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    line-height: 1.4;
    white-space: pre;
    color: var(--color-secondary);
    overflow-x: auto;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .about-section__title {
    font-size: var(--font-size-xl);
    padding-bottom: var(--spacing-sm);
  }

  .about-section__body {
    font-size: var(--font-size-base);
    line-height: 1.6;
  }

  .about-page__cta {
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }
</style>
