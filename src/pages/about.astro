---
import Layout from '@layouts/layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHero from '@components/PageHero.astro';
import StructuredData from '@components/StructuredData.astro';
import { aboutContent } from '@data/about';
import { aboutAsciiArtMobile } from '@data/ascii-artMobile';
import { profile } from '@data/profile';
import { getSocialItems } from '@data/social';

const socialButtons = getSocialItems('github', 'linkedin');
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalURL}#profile`,
  url: canonicalURL,
  name: 'Portfolio | Sobre mí',
  mainEntity: {
    '@type': 'Person',
    '@id': `${canonicalURL}#person`,
    name: profile.name,
    jobTitle: 'Analista de Sistemas',
    description: aboutContent.intro,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Córdoba',
      addressCountry: 'AR',
    },
    sameAs: socialButtons.map((item) => item.url),
  },
};
---

<Layout
  title="Portfolio | Sobre mí"
  description="Analista de sistemas con foco en backend Java y programación orientada a objetos"
>
  <StructuredData data={profileSchema} />
  <Header />
  <main id="main" class="about-page">
    <PageHero
      title={aboutContent.heading}
      intro={aboutContent.intro}
      asciiArt={aboutContent.asciiArt}
      asciiArtMobile={aboutAsciiArtMobile}
      socialItems={socialButtons}
    />

    {aboutContent.sections.map((section) => (
      <section class="about-section">
        <h2 class="about-section__title text-gradient">{section.title}</h2>
        <p class="about-section__body">{section.body}</p>
      </section>
    ))}

    <p class="about-page__cta">{aboutContent.cta}</p>
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .about-section__title {
    font-size: var(--font-size-xl);
    padding-bottom: var(--spacing-sm);
  }

  .about-section__body {
    font-size: var(--font-size-base);
    line-height: 1.6;
  }

  .about-page__cta {
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }
</style>
