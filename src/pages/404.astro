---
import Layout from '@layouts/layout.astro';
import InternalLinkButton from '@components/InternalLinkButton.astro';
import AsciiFigure from '@components/AsciiFigure.astro';
import { notFoundAsciiArt } from '@data/ascii-art';
import { notFoundAsciiArtMobile } from '@data/ascii-artMobile';
---

<Layout
  title="404 | Página no encontrada"
  description="La página que buscas no existe"
>
  <main id="main" class="error-page">
    <div class="error-page__content">
      <h1 class="error-page__title text-gradient">Error 404</h1>
      <p class="error-page__message">Página no encontrada</p>
      <p class="error-page__description">
        La ruta que intentaste visitar no existe o fue movida.
      </p>
      <InternalLinkButton
        label="Volver al inicio"
        href="/"
        variant="primary"
      />
    </div>
    <AsciiFigure art={notFoundAsciiArt} artMobile={notFoundAsciiArtMobile} />
  </main>
</Layout>

<style>
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-3xl);
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    min-height: 100vh;

    @media (max-width: 768px) {
      flex-direction: column;
      text-align: center;
    }
  }

  .error-page__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    max-width: 60ch;
    align-items: flex-start;

    @media (max-width: 768px) {
        align-items: center;
      }
  }

  .error-page__title {
    font-size: var(--font-size-5xl);
  }

  .error-page__message {
    font-size: var(--font-size-2xl);
    font-family: var(--font-family-mono);
    color: var(--color-phosphor);
  }

  .error-page__description {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
