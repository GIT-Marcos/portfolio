---
import Layout from '@layouts/layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHero from '@components/PageHero.astro';
import ServiceSection from '@components/ServiceSection.astro';
import { services, servicesPageContent } from '@data/services';
import { servicesAsciiArt } from '@data/ascii-art';
import { getSocialItems } from '@data/social';
import type { SocialItem } from '@data/social';

const socialButtons: SocialItem[] = getSocialItems('email', 'whatsapp').map((item) => ({
  ...item,
  message: servicesPageContent.contactMessage,
  ...(item.category === 'email' ? { subject: servicesPageContent.contactSubject } : {}),
}));
---

<Layout
  title="Portfolio | Servicios"
  description="Desarrollo web freelance y de software en general: sitios rápidos, accesibles y sistemas con lógica sólida"
>
  <Header />
  <main id="main" class="services-page">
    <PageHero
      title={servicesPageContent.heading}
      intro={servicesPageContent.intro}
      asciiArt={servicesAsciiArt}
      socialItems={socialButtons}
    />

    {services.map((service) => (
      <ServiceSection service={service} />
    ))}
  </main>
  <Footer />
</Layout>

<style>
  .services-page {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }
</style>
