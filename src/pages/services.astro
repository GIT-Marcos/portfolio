---
import Layout from '@layouts/layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHero from '@components/PageHero.astro';
import ServiceSection from '@components/ServiceSection.astro';
import { services, servicesPageContent } from '@data/services';
import { servicesAsciiArt } from '@data/ascii-art';
import { servicesAsciiArtMobile } from '@data/ascii-artMobile';
import { getSocialItems } from '@data/social';
import type { SocialItem } from '@data/social';

const socialButtons: SocialItem[] = getSocialItems('email', 'whatsapp').map((item) => ({
  ...item,
  message: servicesPageContent.contactMessage,
  ...(item.category === 'email' ? { subject: servicesPageContent.contactSubject } : {}),
}));
---

<Layout
  title="Portfolio | Servicios"
  description="Diseño y desarrollo web estático. Desarrollo backend Java. Análisis de sistemas."
>
  <Header />
  <main id="main" class="services-page">
    <PageHero
      title={servicesPageContent.heading}
      intro={servicesPageContent.intro}
      asciiArt={servicesAsciiArt}
      asciiArtMobile={servicesAsciiArtMobile}
      socialItems={socialButtons}
    />

    <h2 class="services-section__title">En lo que puedo ayudarle</h2>

    {services.map((service) => (
      <ServiceSection service={service} />
    ))}
  </main>
  <Footer />
</Layout>

<style>
  .services-page {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .services-section__title {
    font-size: var(--font-size-xl);
    font-family: var(--font-family-mono);
    padding-bottom: var(--spacing-sm);
    margin-top: var(--spacing-3xl);
    border-bottom: 1px solid color-mix(in srgb, var(--color-phosphor) 40%, transparent);
    position: relative;

    &::before {
      content: '> ';
      color: var(--color-phosphor);
      text-shadow: 0 4px 10px color-mix(in srgb, var(--color-phosphor) 90%, transparent);
    }
  }
</style>
